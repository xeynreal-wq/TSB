local function createToggle(name, pos, callback)
    local Btn = Instance.new("TextButton", MainFrame)
    Btn.Size = UDim2.new(0.9, 0, 0, 35)
    Btn.Position = UDim2.new(0.05, 0, 0, pos)
    Btn.Text = name .. ": OFF"
    Btn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.Font = Enum.Font.SourceSansBold
    Btn.TextSize = 13
    
    local enabled = false
    Btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        Btn.Text = name .. (enabled and ": ON" or ": OFF")
        Btn.BackgroundColor3 = enabled and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(150, 40, 40)
        callback(enabled)
    end)
end

-- 1. Clay Mode Button
local ClayBtn = Instance.new("TextButton", MainFrame)
ClayBtn.Size = UDim2.new(0.9, 0, 0, 35)
ClayBtn.Position = UDim2.new(0.05, 0, 0, 40)
ClayBtn.Text = "เปิดภาพดินน้ำมัน 100%"
ClayBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ClayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ClayBtn.Font = Enum.Font.SourceSansBold
ClayBtn.TextSize = 13
ClayBtn.MouseButton1Click:Connect(function()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
    end)
    Lighting.GlobalShadows = false
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then v:Destroy()
        elseif v:IsA("BasePart") then v.Material = Enum.Material.SmoothPlastic
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then v:Destroy() end
    end
end)

