-- 5. Toggle Black Screen
local BlackGui
createToggle("Black Screen (ดัน FPS)", 220, function(val)
    BlackScreen = val
    if BlackScreen then
        BlackGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
        local f = Instance.new("Frame", BlackGui)
        f.Size = UDim2.new(1,0,1,0)
        f.BackgroundColor3 = Color3.new(0,0,0)
        RunService:Set3dRenderingEnabled(false)
    else
        if BlackGui then BlackGui:Destroy() end
        RunService:Set3dRenderingEnabled(true)
    end
end)

-- Core Loop (ใช้ Heartbeat วนลูปเสถียรที่สุด สคริปต์ไม่ตัด)
local lastSkill = tick()
RunService.Heartbeat:Connect(function()
    if AutoFarm and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myHRP = LocalPlayer.Character.HumanoidRootPart
        
        -- หาคน HP น้อยที่สุด
        local target = nil
        local minHP = math.huge
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character:FindFirstChild("HumanoidRootPart") then
                local hum = p.Character.Humanoid
                if hum.Health > 0 and hum.Health < minHP then
                    minHP = hum.Health
                    target = p
                end
            end
        end

        -- วาร์ปเกาะหลัง + กดโจมตีต่อเนื่อง
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local tHRP = target.Character.HumanoidRootPart
            myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, 2)
            
            -- กดต่อยธรรมดา
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)

            -- วนสกิล 1-4
            if tick() - lastSkill > 0.15 then
                lastSkill = tick()
                local keys = {Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}
                local k = keys[math.random(1, #keys)]
                VirtualInputManager:SendKeyEvent(true, k, false, game)
                VirtualInputManager:SendKeyEvent(false, k, false, game)
            end
        end
    end

    -- Auto Ulti (G)
    if AutoUltimate then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.G, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.G, false, game)
    end
end)

