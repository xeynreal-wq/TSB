-- SAFE EXTREME CLAY + LINK EXECUTOR (ALL-IN-ONE)
local Lighting = game:GetService("Lighting")
local Terrain = workspace:FindFirstChildOfClass("Terrain")

-- 1. ปรับกราฟิกดินน้ำมันแบบปลอดภัย (ไม่ลบสคริปต์/UI เกม)
pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
end)

Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1

if Terrain then
    pcall(function() sethiddenproperty(Terrain, "Decoration", false) end)
    Terrain.WaterWaveSize = 0
    Terrain.WaterWaveSpeed = 0
end

local function applySafeClay(v)
    if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
        v:Destroy()
    elseif v:IsA("BasePart") then
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
    elseif v:IsA("MeshPart") then
        v.TextureID = ""
        v.Material = Enum.Material.SmoothPlastic
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
        v.Enabled = false
    end
end

for _, v in pairs(workspace:GetDescendants()) do
    pcall(function() applySafeClay(v) end)
end

workspace.DescendantAdded:Connect(function(v)
    task.spawn(function() pcall(function() applySafeClay(v) end) end)
end)

-- 2. สร้างกล่องใส่ลิงก์สคริปต์
local ScreenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
