local Btn = Instance.new("TextButton", Frame)
Btn.Size = UDim2.new(0.9, 0, 0.28, 0)
Btn.Position = UDim2.new(0.05, 0, 0.68, 0)
Btn.Text = "RUN SCRIPT"
Btn.BackgroundColor3 = Color3.fromRGB(0, 180, 90)
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)

Btn.MouseButton1Click:Connect(function()
    local url = TextBox.Text
    if url ~= "" then
        local success, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        if success then
            Btn.Text = "RUN SUCCESS!"
            Btn.BackgroundColor3 = Color3.fromRGB(0, 220, 0)
        else
            Btn.Text = "ERROR!"
            Btn.BackgroundColor3 = Color3.fromRGB(220, 0, 0)
            warn(err)
        end
        task.wait(1.5)
        Btn.Text = "RUN SCRIPT"
        Btn.BackgroundColor3 = Color3.fromRGB(0, 180, 90)
    end
end)
