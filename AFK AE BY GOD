--[[
    Script Name: อับดุล เถื่อน hub [Delta Mobile Anti-Ban Edition]
    Target Platform: Delta Executor (Mobile Android / iOS)
    Protection: Built-in Anti-Ban, Anti-Kick, Anti-AFK & Log Blocker
--]]

-- ---------------------------------------------------------
-- 1. BUILT-IN ANTI-BAN & LOG BLOCKER ENGINE (ระบบป้องกันหลังบ้าน)
-- ---------------------------------------------------------
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

-- Block Ban / Kick Logs To Server
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
        local name = tostring(self):lower()
        if name:find("ban") or name:find("kick") or name:find("cheat") or name:find("detect") or name:find("log") then
            return nil
        end
    end
    return oldNamecall(self, ...)
end)

-- Anti-AFK / Anti-Kick System
pcall(function()
    local VirtualUser = game:GetService("VirtualUser")
    LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end)

-- ---------------------------------------------------------
-- 2. MACRO DATA & ENGINE SETUP
-- ---------------------------------------------------------
local MouseMacro = {}
local IsRecording = false
local IsPlaying = false
local StartTime = 0

-- UI Setup (Delta Mobile Compatible)
local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "AbdulDeltaMacroHub"

local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 240, 0, 270)
Frame.Position = UDim2.new(0.05, 0, 0.25, 0)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Frame.Active = true
Frame.Draggable = true

local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "อับดุล เถื่อน hub | Delta Mobile"
Title.TextColor3 = Color3.fromRGB(0, 255, 120)
Title.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Title.Font = Enum.Font.SourceSansBold
Title.TextSize = 14

local StatusLabel = Instance.new("TextLabel", Frame)
StatusLabel.Size = UDim2.new(0.9, 0, 0, 25)
StatusLabel.Position = UDim2.new(0.05, 0, 0, 35)
StatusLabel.Text = "สถานะ: ป้องกันแบนเบื้องหลังเรียบร้อย 🛡️"
StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Font = Enum.Font.SourceSans
StatusLabel.TextSize = 12

local function createBtn(text, posY, color, callback)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.Text = text
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 13
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- 3. RECORD BUTTON
local RecBtn
RecBtn = createBtn("🔴 เริ่มอัด Macro (Record)", 65, Color3.fromRGB(180, 40, 40), function()
    if not IsRecording and not IsPlaying then
        MouseMacro = {}
        IsRecording = true
        StartTime = tick()
        StatusLabel.Text = "กำลังอัดการสัมผัสจอ/เมาส์..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        RecBtn.Text = "⏹️ หยุดอัด (Stop)"
    elseif IsRecording then
        IsRecording = false
        StatusLabel.Text = "บันทึกแล้ว (" .. #MouseMacro .. " โหนด) พร้อมวนลูป"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        RecBtn.Text = "🔴 เริ่มอัด Macro (Record)"
    end
end)

-- 4. PLAY AUTO LOOP BUTTON (วนลูปตลอดไป + สุ่มเวลาป้องกันตรวจจับ)
local PlayBtn
PlayBtn = createBtn("▶️ เล่น Macro วนลูปไม่หยุด (Play Loop)", 110, Color3.fromRGB(40, 150, 40), function()
    if #MouseMacro == 0 then
        StatusLabel.Text = "ไม่มีข้อมูลที่อัดไว้!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
        return
    end

    if not IsPlaying and not IsRecording then
        IsPlaying = true
        StatusLabel.Text = "กำลังเล่น Macro วนลูป (Safe Mode)..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        
        task.spawn(function()
            while IsPlaying do
                local playStart = tick()
                for _, action in ipairs(MouseMacro) do
                    if not IsPlaying then break end
                    
                    local timeToWait = action.Time - (tick() - playStart)
                    if timeToWait > 0 then task.wait(timeToWait) end
                    
                    pcall(function()
                        -- Humanizing Jitter (สุ่มหน่วงเวลาเล็กน้อยกันหุ่นยนต์จับ)
                        local jitterX = action.X + math.random(-1, 1)
                        local jitterY = action.Y + math.random(-1, 1)
                        
                        if action.Type == "Move" then
                            VirtualInputManager:SendMouseMoveEvent(jitterX, jitterY, game)
                        elseif action.Type == "ClickDown" then
                            VirtualInputManager:SendMouseButtonEvent(jitterX, jitterY, 0, true, game, 1)
                        elseif action.Type == "ClickUp" then
                            VirtualInputManager:SendMouseButtonEvent(jitterX, jitterY, 0, false, game, 1)
                        elseif action.Type == "Key" then
                            VirtualInputManager:SendKeyEvent(action.Down, action.KeyCode, false, game)
                        end
                    end)
                end
                
                if IsPlaying then
                    StatusLabel.Text = "จบ 1 รอบ -> กำลังเริ่มรอบใหม่..."
                    task.wait(0.5)
                end
            end
        end)
    else
        IsPlaying = false
        StatusLabel.Text = "หยุดเล่น Macro แล้ว"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

-- 5. AUTO REPLAY / PLAY AGAIN
createBtn("🔁 Auto Replay (กดเริ่มเกมใหม่ออโต้)", 155, Color3.fromRGB(80, 80, 180), function()
    task.spawn(function()
        while task.wait(2) do
            pcall(function()
                local gui = LocalPlayer.PlayerGui
                for _, btn in pairs(gui:GetDescendants()) do
                    if btn:IsA("TextButton") and (btn.Text:lower():find("replay") or btn.Text:lower():find("retry") or btn.Text:lower():find("play again")) then
                        firesignal(btn.MouseButton1Click)
                    end
                end
            end)
        end
    end)
    StatusLabel.Text = "เปิด Auto Replay เรียบร้อย"
end)

-- 6. CLAY MODE
createBtn("🧱 เปิดโหมดดินน้ำมัน 100%", 200, Color3.fromRGB(50, 50, 50), function()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
    end)
    Lighting.GlobalShadows = false
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then v:Destroy()
        elseif v:IsA("BasePart") then v.Material = Enum.Material.SmoothPlastic
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then v:Destroy() end
    end
    StatusLabel.Text = "ปรับโหมดดินน้ำมันเรียบร้อย"
end)

-- MOUSE / TOUCH EVENT RECORDING
UserInputService.InputBegan:Connect(function(input, gpe)
    if IsRecording then
        local pos = UserInputService:GetMouseLocation()
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            table.insert(MouseMacro, {Time = tick() - StartTime, Type = "ClickDown", X = pos.X, Y = pos.Y})
        elseif input.UserInputType == Enum.UserInputType.Keyboard then
            table.insert(MouseMacro, {Time = tick() - StartTime, Type = "Key", KeyCode = input.KeyCode, Down = true})
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if IsRecording then
        local pos = UserInputService:GetMouseLocation()
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            table.insert(MouseMacro, {Time = tick() - StartTime, Type = "ClickUp", X = pos.X, Y = pos.Y})
        elseif input.UserInputType == Enum.UserInputType.Keyboard then
            table.insert(MouseMacro, {Time = tick() - StartTime, Type = "Key", KeyCode = input.KeyCode, Down = false})
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if IsRecording then
        local pos = UserInputService:GetMouseLocation()
        table.insert(MouseMacro, {Time = tick() - StartTime, Type = "Move", X = pos.X, Y = pos.Y})
    end
end)
