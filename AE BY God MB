-- 3. MACRO CONTROLS (TOUCH SUPPORT)
-- ---------------------------------------------------------
local RecBtn
RecBtn = CreateButton("🔴 Record Macro (Mobile Touch)", Color3.fromRGB(160, 40, 40), function()
    if not IsRecording and not IsPlaying then
        MouseMacro = {}
        IsRecording = true
        StartTime = tick()
        StatusText.Text = "Status: Recording Touch Actions..."
        StatusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        RecBtn.Text = "⏹️ Stop Recording"
    elseif IsRecording then
        IsRecording = false
        StatusText.Text = "Status: Recorded (" .. #MouseMacro .. " Nodes)"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 140)
        RecBtn.Text = "🔴 Record Macro (Mobile Touch)"
    end
end)

CreateButton("▶️ Play Infinite Loop", Color3.fromRGB(40, 130, 60), function()
    if IsRecording then return end
    if #MouseMacro == 0 then
        StatusText.Text = "Status: No Macro Data!"
        StatusText.TextColor3 = Color3.fromRGB(255, 150, 0)
        return
    end

    if not IsPlaying then
        IsPlaying = true
        StatusText.Text = "Status: Playing Macro Loop..."
        StatusText.TextColor3 = Color3.fromRGB(0, 200, 255)
        
        task.spawn(function()
            while IsPlaying do
                local playStart = tick()
                for _, action in ipairs(MouseMacro) do
                    if not IsPlaying then break end
                    local timeToWait = action.Time - (tick() - playStart)
                    if timeToWait > 0 then task.wait(timeToWait) end
                    
                    pcall(function()
                        local jitterX = action.X + math.random(-1, 1)
                        local jitterY = action.Y + math.random(-1, 1)
                        if action.Type == "Move" then
                            VirtualInputManager:SendMouseMoveEvent(jitterX, jitterY, game)
                        elseif action.Type == "ClickDown" then
                            VirtualInputManager:SendMouseButtonEvent(jitterX, jitterY, 0, true, game, 1)
                        elseif action.Type == "ClickUp" then
                            VirtualInputManager:SendMouseButtonEvent(jitterX, jitterY, 0, false, game, 1)
                        elseif action.Type == "Key" then
                            VirtualInputManager:SendKeyEvent(action.Down, action.KeyCode, false, game)
                        end
                    end)
                end
                if IsPlaying then task.wait(0.5) end
            end
        end)
    end
end)

CreateButton("⏸️ Stop Playback", Color3.fromRGB(190, 90, 0), function()
    if IsPlaying then
        IsPlaying = false
        StatusText.Text = "Status: Stopped Playback ⏸️"
        StatusText.TextColor3 = Color3.fromRGB(255, 200, 100)
    else
        StatusText.Text = "Status: Macro is not playing!"
        StatusText.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end)

CreateButton("🔁 Auto Replay Match", Color3.fromRGB(45, 60, 110), function()
